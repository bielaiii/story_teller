#!/usr/bin/env python3
"""Discover the nearest Story Teller workspace and run its unified CLI."""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path


def projects_in(content_root: Path) -> list[str]:
    if not content_root.is_dir():
        return []
    return sorted(
        path.name
        for path in content_root.iterdir()
        if path.is_dir() and (path / "story.db").is_file()
    )


def discover_workspace(start: Path) -> tuple[Path, Path, list[str]]:
    current = start.resolve()
    for candidate in (current, *current.parents):
        content_root = candidate / "content"
        projects = projects_in(content_root)
        if projects:
            return candidate, content_root.resolve(), projects
    raise RuntimeError(
        f"从 {current} 向上没有找到 content/<project>/story.db；请在 Story Teller 小说仓库内运行"
    )


def discover_framework(workspace_root: Path, launcher: Path) -> Path:
    candidates = (workspace_root / "story_teller", workspace_root, launcher.resolve().parent)
    for candidate in candidates:
        if (
            (candidate / "scripts" / "python.sh").is_file()
            and (candidate / "storyteller" / "cli.py").is_file()
        ):
            return candidate.resolve()
    raise RuntimeError("没有找到支持统一 CLI 的 story_teller 框架")


def select_default_project(
    start: Path,
    workspace_root: Path,
    content_root: Path,
    projects: list[str],
) -> str:
    configured = str(os.environ.get("STORY_TELLER_DEFAULT_PROJECT") or "").strip()
    if configured:
        if configured not in projects:
            raise RuntimeError(f"指定 Project 不存在：{configured}")
        return configured
    resolved_start = start.resolve()
    for project in projects:
        project_root = (content_root / project).resolve()
        if resolved_start == project_root or project_root in resolved_start.parents:
            return project
    if workspace_root.name in projects:
        return workspace_root.name
    return projects[0] if len(projects) == 1 else ""


def discover_hub(workspace_root: Path, framework_root: Path) -> Path:
    configured = str(os.environ.get("STORY_TELLER_HUB_ROOT") or "").strip()
    candidates: list[Path] = []
    if configured:
        candidates.append(Path(configured).expanduser())
    for base in (workspace_root, *workspace_root.parents, framework_root, *framework_root.parents):
        candidates.append(base / "story_teller_hub")
    candidates.append(Path.home() / ".local" / "share" / "story-teller-hub" / "current")
    seen: set[Path] = set()
    for candidate in candidates:
        resolved = candidate.resolve()
        if resolved in seen:
            continue
        seen.add(resolved)
        if (resolved / "run.sh").is_file():
            return resolved
    raise RuntimeError(
        "没有找到 Story Teller Hub；请安装 Hub，或通过 STORY_TELLER_HUB_ROOT 指定其目录"
    )


def repository_root_for(content_root: Path, workspace_root: Path) -> Path:
    completed = subprocess.run(
        ["git", "-C", str(content_root), "rev-parse", "--show-toplevel"],
        check=False,
        capture_output=True,
        text=True,
    )
    value = completed.stdout.strip() if completed.returncode == 0 else ""
    return Path(value).resolve() if value else workspace_root.resolve()


def main() -> int:
    try:
        launcher = Path(__file__).resolve()
        start = Path.cwd()
        workspace_root, content_root, projects = discover_workspace(start)
        framework_root = discover_framework(workspace_root, launcher)
        default_project = select_default_project(start, workspace_root, content_root, projects)
        command = [
            str(framework_root / "scripts" / "python.sh"),
            "-m",
            "storyteller.cli",
            *sys.argv[1:],
        ]
        environment = dict(os.environ)
        environment["STORY_TELLER_WORKSPACE_ROOT"] = str(workspace_root)
        environment["STORY_TELLER_CONTENT_ROOT"] = str(content_root)
        python_path = str(environment.get("PYTHONPATH") or "").strip()
        environment["PYTHONPATH"] = (
            str(framework_root) if not python_path
            else os.pathsep.join((str(framework_root), python_path))
        )
        if default_project:
            environment.setdefault("STORY_TELLER_DEFAULT_PROJECT", default_project)
        help_requested = any(value in {"-h", "--help"} for value in sys.argv[1:])
        direct_worker = bool(
            help_requested
            or environment.get("STORY_TELLER_HUB_CLIENT_ATTACHED") == "1"
            or environment.get("STORY_TELLER_WEB_URL")
            or environment.get("STORY_FRAGMENT_WEB_URL")
            or any(
                value == "--web-url" or value.startswith("--web-url=")
                for value in sys.argv[1:]
            )
        )
        if not direct_worker:
            hub_root = discover_hub(workspace_root, framework_root)
            repository_root = repository_root_for(content_root, workspace_root)
            registration_project = default_project or projects[0]
            command = [
                str(hub_root / "run.sh"),
                "client-exec",
                "--port", str(environment.get("STORY_WORLD_HUB_PORT") or "4188"),
                "--repository-root", str(repository_root),
                "--content-root", str(content_root),
                "--framework-root", str(framework_root),
                "--client-cwd", str(start),
                "--project", registration_project,
                "--display-name", repository_root.name,
                "--",
                *command,
            ]
        if os.environ.get("STORY_TELLER_DRY_RUN") == "1":
            print(json.dumps({
                "workspaceRoot": str(workspace_root),
                "frameworkRoot": str(framework_root),
                "contentRoot": str(content_root),
                "projects": projects,
                "defaultProject": default_project,
                "command": command,
            }, ensure_ascii=False, sort_keys=True))
            return 0
        os.execve(command[0], command, environment)
    except (OSError, RuntimeError, ValueError) as error:
        print(f"story-teller: {error}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
